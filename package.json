{
  "name": "be-logbook",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.17.0"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "predev": "node scripts/check-dev-port.js",
    "dev": "node scripts/run-web.js dev -p 3000",
    "api:dev": "tsx watch apps/api/src/server.ts",
    "api:build": "tsc -p apps/api/tsconfig.json",
    "test:visual": "playwright test",
    "api:start": "node apps/api/dist/server.js",
    "build": "node scripts/run-web.js build",
    "start": "node scripts/run-web.js start -p 3000",
    "lint": "npm run lint --workspace @be-logbook/web",
    "typecheck": "npm run typecheck --workspace @be-logbook/web && npm run typecheck --workspace @be-logbook/api",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node scripts/migrate-deploy.js",
    "db:seed": "tsx prisma/seed.ts",
    "storage:migrate-private": "tsx scripts/migrate-uploads-to-private.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
