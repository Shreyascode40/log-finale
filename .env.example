# ---------------------------------------------------------------- database
# Development uses SQLite. Switch to PostgreSQL in production, e.g.:
#   DATABASE_URL="postgresql://user:pass@host:5432/logbook?schema=public"
# and change provider = "sqlite" to "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------- auth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Restrict student self sign-up to one email domain. Leave empty to allow any.
# Example: ALLOWED_EMAIL_DOMAIN="apcoer.edu.in"
ALLOWED_EMAIL_DOMAIN=""

# ---------------------------------------------------------------- email (F2/F17)
# Leave EMAIL_PROVIDER="console" in development to print emails to the server log.
EMAIL_PROVIDER="console"
EMAIL_FROM="Digital BE Log Book <no-reply@localhost>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------- uploads
# "local" writes to /public/uploads in dev; "cloudinary" in production.
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------- pdf
# Base URL the Puppeteer renderer uses to load /print/[groupId]
PDF_BASE_URL="http://localhost:3000"
