# ---------------------------------------------------------------- database
# PostgreSQL (Supabase). DATABASE_URL is the transaction-pooler connection used
# by the app at runtime; DIRECT_URL is the session-pooler connection used by
# Prisma Migrate. Supabase dashboard -> Project Settings -> Database.
#
# The transaction pooler MUST include pgbouncer=true, otherwise Prisma prepared
# statements collide under load ("prepared statement already exists").
# connection_limit=5 is appropriate for one Render service; use a lower limit
# for serverless deployments. pool_timeout=30 gives a cold pool time to connect.
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ---------------------------------------------------------------- tests
# Create a git-ignored .env.test.local with a SEPARATE schema (never public).
# `npm test` drops and recreates this schema on every run.
# TEST_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=30&schema=logbook_test"
# TEST_DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?schema=logbook_test"

# ---------------------------------------------------------------- auth
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-me-with-a-long-random-secret"
# Local dev below. In production set this to the live URL (and redeploy),
# e.g. NEXTAUTH_URL="https://be-logbook.onrender.com"
NEXTAUTH_URL="http://localhost:3000"

# Restrict student self sign-up to one email domain. Leave empty to allow any.
# Example: ALLOWED_EMAIL_DOMAIN="apcoer.edu.in"
ALLOWED_EMAIL_DOMAIN=""

# ---------------------------------------------------------------- email (F2/F17)
# Leave EMAIL_PROVIDER="console" in development to print emails to the server log.
EMAIL_PROVIDER="console"
EMAIL_FROM="Digital BE Log Book <no-reply@localhost>"
# Demo kill-switch for email verification. Default (absent or anything but
# "false") requires new students to click the verification link before login.
# Set to "false" for demos so accounts activate instantly with no mailbox;
# flip it back afterwards to restore the normal flow.
# REQUIRE_EMAIL_VERIFICATION="false"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------- uploads
# "local" writes to var/uploads in dev (served by the /media route).
# "supabase" uploads to a public Supabase Storage bucket in production.
UPLOAD_PROVIDER="local"
# Supabase project URL + bucket (Storage -> New bucket -> public, e.g. name
# "logbook-uploads"). SUPABASE_SERVICE_ROLE_KEY is server-side only: it
# bypasses storage policies, so never expose it to the browser or commit it.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="logbook-uploads"

# ---------------------------------------------------------------- pdf
# Base URL the Puppeteer renderer uses to load /print/[groupId]. Local dev
# below; in production set this to the live URL (and redeploy).
PDF_BASE_URL="http://localhost:3000"
# Path to a Chrome/Chromium executable for PDF rendering (puppeteer-core
# brings no browser of its own). On Windows the default install path is used
# automatically; the production Dockerfile installs Chromium and sets
# CHROME_PATH=/usr/bin/chromium.
# Example: CHROME_PATH="C:\Program Files\Google\Chrome\Application\chrome.exe"
CHROME_PATH=""
